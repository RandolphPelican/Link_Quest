{
  "name": "link-quest",
  "version": "2.1.0",
  "description": "Multiplayer RPG foundation",
  "main": "server.js",
  "scripts": {
    "build": "npm run build:server && npm run build:client",

    "build:client": "tsc -p src/client && vite build src/client",
    "build:server": "tsc -p src/server",
    "start": "node server.js",
    "dev:server": "ts-node-dev --respawn src/server/index.ts",
    "dev:client": "vite"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.0",
    "colyseus": "^0.15.0",
    "colyseus.js": "^0.15.0",
    "express": "^4.18.2",
    "phaser": "^3.60.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^4.4.5"
  }
}
